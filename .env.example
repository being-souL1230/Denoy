# =====================================================================
# Digital Dark Spot Configuration (100% Free AI Setup)
# =====================================================================

# 1. PRIMARY FREE AI PROVIDER: Groq
# Get a 100% free API key from https://console.groq.com/keys
# Groq provides ultra-fast inference with Llama-3.3-70B on their free tier.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. ALTERNATIVE FREE PROVIDER: Google Gemini
# Optional: Free API key from https://aistudio.google.com/
GEMINI_API_KEY=

# 3. OFFLINE MOCK MODE
# Set MOCK_LLM=1 to test everything completely offline without any API key.
# If no API key is provided above, the system automatically falls back to MOCK mode.
MOCK_LLM=1
